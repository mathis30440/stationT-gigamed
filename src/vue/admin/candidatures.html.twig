{% extends 'base/base.html.twig' %}

{% block titre %}Candidatures — Administration{% endblock %}

{% block contenu %}

{% set sColor = {
    'brouillon':      'background:#fef3c7; color:#92400e;',
    'déposé':         'background:#dbeafe; color:#1d4ed8;',
    'éligible':       'background:#d1fae5; color:#065f46;',
    'incomplet':      'background:#fef9c3; color:#854d0e;',
    'en instruction': 'background:#ede9fe; color:#5b21b6;',
    'sélectionné':    'background:#d1fae5; color:#065f46;',
    'refusé':         'background:#fee2e2; color:#991b1b;'
} %}

<div class="admin-hero">
    <div class="admin-hero-left">
        <span class="admin-hero-tag">Administration</span>
        <h1>Candidatures</h1>
        <p>{{ candidatures|length }} candidature(s) enregistrée(s) sur la plateforme</p>
    </div>
    <div class="admin-hero-right">
        {% if utilisateur.roleUtilisateur.value == 'superAdmin' %}
        <a href="{{ route('adminAfficherFormulaireSoumettreCandidature') }}" class="btn btn-blue">+ Candidature</a>
        {% endif %}
        <a href="{{ route('adminDashboard') }}" class="btn btn-outline-white">← Tableau de bord</a>
    </div>
</div>

<div class="admin-nav-strip">
    <a href="{{ route('adminDashboard') }}">Tableau de bord</a>
    <span class="admin-nav-sep"></span>
    <a href="{{ route('adminUtilisateurs') }}">Utilisateurs</a>
    <a href="{{ route('adminBesoins') }}">Besoins</a>
    <a href="{{ route('adminCandidatures') }}" class="admin-nav-active">Candidatures</a>
    <a href="{{ route('adminAmi') }}">AMI</a>
    <a href="{{ route('adminChallenges') }}">Challenges</a>
    <span class="admin-nav-sep"></span>
    {% if utilisateur.roleUtilisateur.value == 'superAdmin' %}<a href="{{ route('adminAffectations') }}">Affectations</a>{% endif %}
    <a href="{{ route('adminJournal') }}">Journal</a>
</div>

<div class="admin-wide">
<div class="admin-card">
    <div class="admin-card-head">
        <h2>Liste des candidatures</h2>
        <span class="admin-card-count">{{ candidatures|length }}</span>
    </div>
    <div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Projet</th>
                <th>Filière</th>
                <th>Déposée le</th>
                <th>Statut actuel</th>
                <th>Changer le statut</th>
            </tr>
        </thead>
        <tbody>
            {% for c in candidatures %}
            <tr>
                <td class="td-id">{{ c.idCandidature }}</td>
                <td>
                    <a href="{{ route('adminDetailCandidature', {id: c.idCandidature}) }}" class="tlink">{{ c.nomProjet }}</a>
                </td>
                <td class="td-muted">{{ c.filiereCandidat ?? '—' }}</td>
                <td class="td-muted">{{ c.dateDepot|date('d/m/Y') }}</td>
                <td>
                    <span class="abadge" style="{{ sColor[c.statutCandidature.value] ?? 'background:#f3f4f6; color:#374151;' }}">
                        {{ c.statutCandidature.value }}
                    </span>
                </td>
                <td>
                    {% set ferme = (c.idAmi is not null and c.idAmi in amisFermes) or (c.idChallenge is not null and c.idChallenge in challengesFermes) %}
                    {% if c.statutCandidature.value == 'brouillon' and c.idUtilisateur == utilisateur.idUtilisateur %}
                    <a href="{{ route('adminAfficherFormulaireSoumettreCandidature') }}?id={{ c.idCandidature }}" class="abtn" style="background:#f59e0b; color:#fff;">Continuer</a>
                    {% if utilisateur.roleUtilisateur.value == 'superAdmin' %}
                    <form method="POST" action="{{ route('adminSupprimerCandidature', {id: c.idCandidature}) }}"
                          onsubmit="return confirm('Supprimer ce brouillon ?')" style="display:inline;">
                        <button type="submit" class="abtn abtn-red">Supprimer</button>
                    </form>
                    {% endif %}
                    {% elseif c.statutCandidature.value == 'en instruction' %}
                    <span style="font-size:.82rem; color:#5b21b6;">Notation terminée</span>
                    {% else %}
                    <form method="POST" action="{{ route('adminChangerStatutCandidature', {id: c.idCandidature}) }}"
                          style="display:flex; flex-direction:column; gap:.4rem;">
                        <div style="display:flex; gap:.4rem; align-items:center;">
                            <select name="statut" class="admin-select statut-select" data-id="{{ c.idCandidature }}">
                                {% for s in statuts %}
                                <option value="{{ s.value }}" {% if s == c.statutCandidature %}selected{% endif %}>{{ s.value }}</option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="abtn abtn-blue">Appliquer</button>
                        </div>
                        <div class="bloc-incomplet-{{ c.idCandidature }}" style="display:none;">
                            <textarea name="messageIncomplet" rows="3"
                                      placeholder="Éléments manquants (obligatoire)..."
                                      style="width:100%; padding:.5rem; border:1px solid #f59e0b; border-radius:6px; font-size:.82rem; resize:vertical;"></textarea>
                        </div>
                        <div class="bloc-refus-{{ c.idCandidature }}" style="display:none;">
                            <textarea name="messageRefus" rows="3"
                                      placeholder="Motif du refus (obligatoire)..."
                                      style="width:100%; padding:.5rem; border:1px solid #dc2626; border-radius:6px; font-size:.82rem; resize:vertical;"></textarea>
                        </div>
                    </form>
                    {% endif %}
                </td>
            </tr>
            {% else %}
            <tr class="admin-empty-row"><td colspan="6">Aucune candidature enregistrée.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
</div>

<script>
document.querySelectorAll('.statut-select').forEach(function(sel) {
    var id = sel.dataset.id;
    var blocIncomplet = document.querySelector('.bloc-incomplet-' + id);
    var blocRefus = document.querySelector('.bloc-refus-' + id);
    var taIncomplet = blocIncomplet ? blocIncomplet.querySelector('textarea') : null;
    var taRefus = blocRefus ? blocRefus.querySelector('textarea') : null;
    function toggle() {
        var isIncomplet = sel.value === 'incomplet';
        var isRefus = sel.value === 'refusé';
        if (blocIncomplet) blocIncomplet.style.display = isIncomplet ? 'block' : 'none';
        if (blocRefus) blocRefus.style.display = isRefus ? 'block' : 'none';
        if (taIncomplet) taIncomplet.required = isIncomplet;
        if (taRefus) taRefus.required = isRefus;
    }
    sel.addEventListener('change', toggle);
    toggle();
});
</script>

{% endblock %}