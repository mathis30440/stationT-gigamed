{% extends 'base/base.html.twig' %}

{% block titre %}AMI ouverts — Station T{% endblock %}

{% block contenu %}

<section class="hero">
    <div class="hero-tag">Appels à Manifestation d'Intérêt</div>
    <h1>AMI ouverts</h1>
    <p>Candidatez aux appels en cours et proposez vos solutions innovantes sur le territoire.</p>
    <div class="hero-actions">
        <a href="{{ route('listeChallenges') }}" class="btn btn-outline-white">Voir les Challenges →</a>
    </div>
</section>

{% include 'base/_partials/filiere_colors.html.twig' %}

<div class="page-header">
    <div>
        <h2 class="page-title">{{ amis|length }} AMI{{ amis|length > 1 ? 's' : '' }} ouvert{{ amis|length > 1 ? 's' : '' }}</h2>
        <p class="page-subtitle">Déposez votre dossier avant la date de clôture</p>
    </div>
</div>

{% if amis is empty %}
<div class="form-card" style="text-align:center; padding:3rem;">
    <p style="font-size:1.1rem; color:var(--gris-texte); margin-bottom:.5rem;">Aucun AMI ouvert pour le moment.</p>
    <p style="color:var(--gris-texte); font-size:.9rem;">Consultez les Challenges disponibles en attendant.</p>
</div>
{% else %}
<div class="cards-list">
{% for ami in amis %}
{% set fc = filiere_colors[ami.filiere.value] ?? '#00a9c0' %}
{% set fb = filiere_bg[ami.filiere.value] ?? '#e8f0fb' %}
<div style="background:#fff; border-radius:12px; box-shadow:var(--ombre); overflow:hidden;">

        <div style="background:linear-gradient(135deg, var(--bleu-fonce) 0%, var(--bleu-moyen) 100%); padding:.75rem 1.75rem; display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
        <div style="display:flex; gap:.5rem; align-items:center;">
            <span style="background:rgba(255,255,255,.2); border:1px solid rgba(255,255,255,.35); color:#fff; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; padding:.22rem .65rem; border-radius:20px;">AMI</span>
            <span style="background:rgba(255,255,255,.2); border:1px solid rgba(255,255,255,.35); color:#fff; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; padding:.22rem .65rem; border-radius:20px;">{{ ami.filiere.value|capitalize }}</span>
        </div>
        <span style="color:rgba(255,255,255,.9); font-size:.82rem; font-weight:700;">Clôture : <strong style="color:#fff;">{{ ami.dateCloture|date('d/m/Y') }}</strong></span>
    </div>

        <div style="padding:1.5rem 1.75rem; display:flex; flex-direction:column; gap:.85rem;">
        <h2 style="font-size:1.15rem; font-weight:800; color:var(--bleu-fonce); line-height:1.35; margin:0;">{{ ami.titreAmi }}</h2>
        <p style="color:var(--gris-texte); font-size:.92rem; line-height:1.65; margin:0;">{{ ami.objectifAmi }}</p>

        <div style="display:flex; gap:.65rem; flex-wrap:wrap;">
            <span style="font-size:.82rem; background:var(--bleu-clair); color:var(--bleu-moyen); padding:.3rem .75rem; border-radius:20px; font-weight:600;">{{ ami.publicVise }}</span>
            <span style="font-size:.82rem; background:var(--bleu-clair); color:var(--bleu-moyen); padding:.3rem .75rem; border-radius:20px; font-weight:600;">{{ ami.dureeIndicative }}</span>
            <span style="font-size:.82rem; background:var(--bleu-clair); color:var(--bleu-moyen); padding:.3rem .75rem; border-radius:20px; font-weight:600;">Résultats : {{ ami.dateResultats|date('d/m/Y') }}</span>
        </div>

        <div style="display:flex; align-items:center; justify-content:space-between; gap:.75rem; flex-wrap:wrap; padding-top:.5rem; border-top:1px solid var(--gris-clair);">
            <a href="{{ route('detailAmi', {id: ami.idAmi}) }}" style="font-size:.88rem; font-weight:700; color:var(--bleu-moyen); text-decoration:none;">Voir les détails →</a>
            {% if not peutCandidater %}
            <span style="font-size:.85rem; color:var(--gris-texte);">Consultation uniquement</span>
            {% elseif hasBesoin %}
            <span style="font-size:.85rem; color:#92400e; background:#fef3c7; padding:.4rem .8rem; border-radius:8px; font-weight:600;">Besoin soumis</span>
            {% elseif ami.idAmi in amisCandidates %}
            <span style="font-size:.85rem; color:#065f46; background:#d1fae5; padding:.4rem .8rem; border-radius:8px; font-weight:600;">Candidature soumise</span>
            {% else %}
            <a href="{{ route('afficherFormulaireCandidatureAmi', {idAmi: ami.idAmi}) }}" class="btn btn-blue" style="padding:.5rem 1.2rem;">Candidater →</a>
            {% endif %}
        </div>
    </div>

</div>
{% endfor %}
</div>
{% endif %}

{% endblock %}