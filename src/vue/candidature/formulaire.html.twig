{% if isModification %}
<script>
function supprimerDoc(idDoc, url, btn) {
    if (!confirm('Supprimer ce fichier ?')) return;
    btn.disabled = true; btn.textContent = '…';
    fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.ok) {
            var inputName = btn.dataset.input;
            var isRequired = btn.dataset.required === '1';
            var currentDiv = document.getElementById('doc-current-' + inputName);
            if (currentDiv) currentDiv.remove();
            var group = btn.closest('.form-group');
            if (group) {
                group.querySelectorAll('p.doc-hint').forEach(function(h) { h.remove(); });
                if (isRequired) {
                    var input = document.getElementById(inputName);
                    if (input) input.setAttribute('required', '');
                    var label = group.querySelector('label');
                    if (label && !label.querySelector('.required')) { label.insertAdjacentHTML('beforeend', ' <span class="required">*</span>'); }
                }
            }
        } else { btn.disabled = false; btn.textContent = 'Supprimer'; alert('Erreur lors de la suppression.'); }
    })
    .catch(function() { btn.disabled = false; btn.textContent = 'Supprimer'; alert('Erreur réseau.'); });
}
function syncFiliereMod() {
    var hidden = document.getElementById('filiereCandidat-mod-hidden');
    if (!hidden) return;
    var b1 = document.getElementById('mod-bloc-filiere-option1');
    var b2 = document.getElementById('mod-bloc-filiere-option2');
    var sel1 = document.getElementById('mod-filiere-select-opt1');
    var sel2 = document.getElementById('mod-filiere-select-opt2');
    if (b1 && b1.style.display !== 'none' && sel1) {
        hidden.value = sel1.value;
    } else if (b2 && b2.style.display !== 'none' && sel2) {
        hidden.value = sel2.value;
    } else {
        hidden.value = '';
    }
}

function majFiliereMod(option) {
    var b1 = document.getElementById('mod-bloc-filiere-option1');
    var b2 = document.getElementById('mod-bloc-filiere-option2');
    if (b1) b1.style.display = (option === 'option1') ? '' : 'none';
    if (b2) b2.style.display = (option === 'option2') ? '' : 'none';
    syncFiliereMod();
}

document.addEventListener('DOMContentLoaded', function() {
    var checked = document.querySelector('input[name="entreeStationT"]:checked');
    if (checked) majFiliereMod(checked.value);
    var sel1 = document.getElementById('mod-filiere-select-opt1');
    if (sel1) sel1.addEventListener('change', syncFiliereMod);
    var sel2 = document.getElementById('mod-filiere-select-opt2');
    if (sel2) sel2.addEventListener('change', syncFiliereMod);

    document.querySelectorAll('input[type="file"]').forEach(function(input) {
        var clearBtn = document.createElement('button');
        clearBtn.type = 'button'; clearBtn.textContent = '✕ Effacer la sélection'; clearBtn.className = 'abtn abtn-red';
        clearBtn.style.cssText = 'display:none; padding:.2rem .55rem; font-size:.78rem; margin-top:.35rem;';
        input.after(clearBtn);
        input.addEventListener('change', function() { clearBtn.style.display = this.files.length ? 'inline-block' : 'none'; });
        clearBtn.addEventListener('click', function() { input.value = ''; this.style.display = 'none'; });
    });
    var appuisCheckboxes = document.querySelectorAll('input[name="appuisStationT[]"]');
    var appuisHidden = document.getElementById('appuisStationT-mod-hidden');
    if (appuisCheckboxes.length && appuisHidden) {
        function syncAppuisMod() {
            appuisHidden.value = Array.from(appuisCheckboxes).filter(function(cb) { return cb.checked; }).map(function(cb) { return cb.value; }).join(', ');
        }
        appuisCheckboxes.forEach(function(cb) { cb.addEventListener('change', syncAppuisMod); });
        syncAppuisMod();
    }
});
</script>
{% elseif isAdmin and not isModification %}
<script>
function supprimerDoc(idDoc, url, btn) {
    if (!confirm('Supprimer ce fichier ?')) return;
    btn.disabled = true; btn.textContent = '…';
    fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.ok) {
            var inputId = btn.dataset.input;
            var isRequired = btn.dataset.required === '1';
            var currentDiv = document.getElementById('doc-current-' + inputId);
            if (currentDiv) currentDiv.remove();
            var group = btn.closest('.form-group');
            if (group) {
                group.querySelectorAll('p.doc-hint').forEach(function(h) { h.remove(); });
                if (isRequired) {
                    var input = document.getElementById(inputId);
                    if (input) input.setAttribute('required', '');
                    var label = group.querySelector('label');
                    if (label && !label.querySelector('.required')) { label.insertAdjacentHTML('beforeend', ' <span class="required">*</span>'); }
                }
            }
        } else { btn.disabled = false; btn.textContent = 'Supprimer'; alert('Erreur lors de la suppression.'); }
    })
    .catch(function() { btn.disabled = false; btn.textContent = 'Supprimer'; alert('Erreur réseau.'); });
}

var roleActuel = '';

function majRole(select) {
    var role = select.options[select.selectedIndex].dataset.role;
    roleActuel = role;
    var isEntreprise = (role === 'entreprise');
    var formContent = document.getElementById('form-content');
    if (!role || role === '') { formContent.style.display = 'none'; return; }
    formContent.style.display = '';
    document.querySelectorAll('.section-startup').forEach(function(el) {
        el.style.display = isEntreprise ? 'none' : '';
        el.querySelectorAll('input, textarea, select').forEach(function(i) { i.disabled = isEntreprise; });
    });
    document.querySelectorAll('.section-entreprise').forEach(function(el) {
        el.style.display = isEntreprise ? '' : 'none';
        el.querySelectorAll('input, textarea, select').forEach(function(i) { i.disabled = !isEntreprise; });
    });
    majFiliere(getEntreeChecked());
}

function getEntreeChecked() {
    var checked = document.querySelector('input[name="entreeStationT"]:checked');
    return checked ? checked.value : '';
}

function majFiliere(option) {
    var isEntreprise = (roleActuel === 'entreprise');
    document.getElementById('bloc-filiere-option1').style.display = (option === 'option1') ? 'block' : 'none';
    document.getElementById('bloc-filiere-option2-entreprise').style.display = (option === 'option2' && isEntreprise) ? 'block' : 'none';
    document.getElementById('bloc-filiere-option2-startup').style.display = (option === 'option2' && !isEntreprise) ? 'block' : 'none';
    if (option === 'option3') { document.getElementById('filiereCandidat-hidden').value = ''; }
}

document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.section-role').forEach(function(el) {
        el.querySelectorAll('input, textarea, select').forEach(function(i) { i.disabled = true; });
    });
    var selectUser = document.getElementById('idUtilisateur');
    if (selectUser.value && selectUser.value !== '0') { majRole(selectUser); }
    var sel1 = document.getElementById('filiere-select-opt1');
    if (sel1) sel1.addEventListener('change', function() { document.getElementById('filiereCandidat-hidden').value = this.value; });
    var sel2e = document.getElementById('filiere-select-opt2-e');
    if (sel2e) sel2e.addEventListener('change', function() { document.getElementById('filiereCandidat-hidden').value = this.value; });
    var sel2s = document.getElementById('filiere-select-opt2-s');
    if (sel2s) sel2s.addEventListener('change', function() { document.getElementById('filiereCandidat-hidden').value = this.value; });
    var appuisCheckboxes = document.querySelectorAll('input[name="appuisStationT[]"]');
    var appuisHidden = document.getElementById('appuisStationT-hidden');
    if (appuisCheckboxes.length && appuisHidden) {
        function syncAppuis() {
            appuisHidden.value = Array.from(appuisCheckboxes).filter(function(cb) { return cb.checked; }).map(function(cb) { return cb.value; }).join(', ');
        }
        appuisCheckboxes.forEach(function(cb) { cb.addEventListener('change', syncAppuis); });
        syncAppuis();
    }
    var checked = document.querySelector('input[name="entreeStationT"]:checked');
    if (checked) majFiliere(checked.value);

    document.querySelectorAll('input[type="file"]').forEach(function(input) {
        var clearBtn = document.createElement('button');
        clearBtn.type = 'button'; clearBtn.textContent = '✕ Effacer la sélection'; clearBtn.className = 'abtn abtn-red';
        clearBtn.style.cssText = 'display:none; padding:.2rem .55rem; font-size:.78rem; margin-top:.35rem;';
        input.after(clearBtn);
        input.addEventListener('change', function() { clearBtn.style.display = this.files.length ? 'inline-block' : 'none'; });
        clearBtn.addEventListener('click', function() { input.value = ''; this.style.display = 'none'; });
    });
});
</script>
{% elseif not isAdmin %}
<script>
function supprimerDoc(idDoc, url, btn) {
    if (!confirm('Supprimer ce fichier ?')) return;
    btn.disabled = true; btn.textContent = '…';
    fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.ok) {
            var inputName = btn.dataset.input;
            var isRequired = btn.dataset.required === '1';
            var currentDiv = document.getElementById('doc-current-' + inputName);
            if (currentDiv) currentDiv.remove();
            var group = btn.closest('.form-group');
            if (group) {
                group.querySelectorAll('p.doc-hint').forEach(function(h) { h.remove(); });
                if (isRequired) {
                    var input = document.getElementById(inputName);
                    if (input) input.setAttribute('required', '');
                    var label = group.querySelector('label');
                    if (label && !label.querySelector('.required')) { label.insertAdjacentHTML('beforeend', ' <span class="required">*</span>'); }
                }
            }
        } else { btn.disabled = false; btn.textContent = 'Supprimer'; alert('Erreur lors de la suppression.'); }
    })
    .catch(function() { btn.disabled = false; btn.textContent = 'Supprimer'; alert('Erreur réseau.'); });
}

