                <input type="file" id="doc_kbis" name="doc_kbis" accept=".pdf,.jpg,.jpeg,.png" {% if docs['doc_kbis'] is not defined %}required{% endif %}>
            </div>
            <div class="form-group">
                <label for="doc_assurance">Attestation d'assurance responsabilité civile professionnelle {% if docs['doc_assurance'] is not defined %}<span class="required">*</span>{% endif %}</label>
                {{ _self.docActuel(docs['doc_assurance'] ?? null, 'doc_assurance', true) }}
                {% if docs['doc_assurance'] is defined %}<p class="form-hint doc-hint" style="color:#059669;">Laisser vide pour conserver, ou choisir un nouveau fichier pour remplacer.</p>{% endif %}
                <input type="file" id="doc_assurance" name="doc_assurance" accept=".pdf,.jpg,.jpeg,.png" {% if docs['doc_assurance'] is not defined %}required{% endif %}>
            </div>
            <div class="form-group">
                <label for="doc_references">Références clients, pilotes ou démonstrations disponibles <span class="optional">(optionnel)</span></label>
                {{ _self.docActuel(docs['doc_references'] ?? null, 'doc_references', false) }}
                {% if docs['doc_references'] is defined %}<p class="form-hint doc-hint" style="color:#059669;">Laisser vide pour conserver, ou choisir un nouveau fichier pour remplacer.</p>{% endif %}
                <input type="file" id="doc_references" name="doc_references" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png">
            </div>
            <div class="form-group">
                <label for="doc_technique">Documentation technique ou fonctionnelle <span class="optional">(optionnel)</span></label>
                {{ _self.docActuel(docs['doc_technique'] ?? null, 'doc_technique', false) }}
                {% if docs['doc_technique'] is defined %}<p class="form-hint doc-hint" style="color:#059669;">Laisser vide pour conserver, ou choisir un nouveau fichier pour remplacer.</p>{% endif %}
                <input type="file" id="doc_technique" name="doc_technique" accept=".pdf,.doc,.docx">
            </div>
            <div class="form-group">
                <label for="doc_financier">Éléments financiers ou modèle économique synthétique <span class="optional">(optionnel)</span></label>
                {{ _self.docActuel(docs['doc_financier'] ?? null, 'doc_financier', false) }}
                {% if docs['doc_financier'] is defined %}<p class="form-hint doc-hint" style="color:#059669;">Laisser vide pour conserver, ou choisir un nouveau fichier pour remplacer.</p>{% endif %}
                <input type="file" id="doc_financier" name="doc_financier" accept=".pdf,.xls,.xlsx,.doc,.docx">
            </div>
            <div class="form-group">
                <label for="doc_rgpd">Conditions générales, politique de confidentialité ou documents RGPD <span class="optional">(optionnel)</span></label>
                {{ _self.docActuel(docs['doc_rgpd'] ?? null, 'doc_rgpd', false) }}
                {% if docs['doc_rgpd'] is defined %}<p class="form-hint doc-hint" style="color:#059669;">Laisser vide pour conserver, ou choisir un nouveau fichier pour remplacer.</p>{% endif %}
                <input type="file" id="doc_rgpd" name="doc_rgpd" accept=".pdf,.doc,.docx">
            </div>
            <div class="form-group">
                <label for="doc_autre_e">Autre document utile <span class="optional">(optionnel)</span></label>
                {{ _self.docActuel(docs['doc_autre'] ?? null, 'doc_autre_e', false) }}
                {% if docs['doc_autre'] is defined %}<p class="form-hint doc-hint" style="color:#059669;">Laisser vide pour conserver, ou choisir un nouveau fichier pour remplacer.</p>{% endif %}
                <input type="file" id="doc_autre_e" name="doc_autre" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png">
            </div>
        </div>
    </div>
    </div>
    <div style="display:flex; gap:1rem; margin-bottom:3rem;">
        <button type="submit" name="action" value="soumettre" class="btn btn-blue" style="flex:1; justify-content:center;">Soumettre la candidature</button>
        <button type="submit" name="action" value="brouillon" formnovalidate class="btn" style="background:#f59e0b; color:#fff; border:none; white-space:nowrap;">Sauvegarder en brouillon</button>
        <a href="{{ route('adminCandidatures') }}" class="btn" style="background:var(--gris-moyen); color:var(--texte);">Annuler</a>
    </div>

{% else %}

    <div class="form-card">
        <h2>1. Identification du projet</h2>
        <div class="form-group">
            <label for="nomProjet">Nom du projet / de la solution <span class="required">*</span></label>
            <input type="text" id="nomProjet" name="nomProjet" value="{{ v.nomProjet ?? '' }}" required placeholder="Ex : TouriConnect">
        </div>
    </div>

    <div class="form-card">
        <h2>2. Cas d'usage ou besoin territorial traité</h2>
        <div class="form-group">
            <label>Entrée dans Station T <span class="required">*</span></label>
            <div class="form-radio-group">
                <label class="radio-label">
                    <input type="radio" name="entreeStationT" value="option1" {% if (v.entreeStationT ?? '') == 'option1' %}checked{% endif %} required onchange="majFiliere(this.value)">
                    <span><strong>Option 01</strong> — Réponse à un besoin filière identifié</span>
                </label>
                <label class="radio-label">
                    <input type="radio" name="entreeStationT" value="option2" {% if (v.entreeStationT ?? '') == 'option2' %}checked{% endif %} onchange="majFiliere(this.value)">
                    <span><strong>Option 02</strong> — Réponse à un cas d'usage interfilières Station T</span>
                </label>
                <label class="radio-label">
                    <input type="radio" name="entreeStationT" value="option3" {% if (v.entreeStationT ?? '') == 'option3' %}checked{% endif %} onchange="majFiliere(this.value)">
                    <span><strong>Option 03</strong> — Besoin complémentaire proposé par le candidat avec pertinence territoriale démontrée</span>
                </label>
            </div>
        </div>
        <input type="hidden" name="filiereCandidat" id="filiereCandidat-hidden" value="{{ v.filiereCandidat ?? '' }}">
        <div id="bloc-filiere-option1" style="display:none;">
            <div class="form-group">
                <label for="filiere-select-opt1">Filière concernée <span class="required">*</span></label>
                <select id="filiere-select-opt1">
                    <option value="">— Sélectionnez une filière —</option>
                    <option value="tourisme"    {% if (v.filiereCandidat ?? '') == 'tourisme' %}selected{% endif %}>Tourisme balnéaire &amp; durable</option>
                    <option value="nautisme"    {% if (v.filiereCandidat ?? '') == 'nautisme' %}selected{% endif %}>Nautisme, plaisance &amp; fluvial</option>
                    <option value="sport"       {% if (v.filiereCandidat ?? '') == 'sport' %}selected{% endif %}>Sport, bien-être &amp; loisirs</option>
                    <option value="agriculture" {% if (v.filiereCandidat ?? '') == 'agriculture' %}selected{% endif %}>Agriculture &amp; viticulture</option>
                    <option value="commerce"    {% if (v.filiereCandidat ?? '') == 'commerce' %}selected{% endif %}>Commerce &amp; artisanat</option>
                    <option value="ville"       {% if (v.filiereCandidat ?? '') == 'ville' %}selected{% endif %}>Ville de demain &amp; services de proximité</option>
                </select>
            </div>
        </div>
        <div id="bloc-filiere-option2" style="display:none;">
            <div class="form-group">
                <label for="filiere-select-opt2">Cas d'usage interfilières <span class="required">*</span></label>
                <select id="filiere-select-opt2">
                    <option value="">— Sélectionnez un cas d'usage —</option>
                    {% if isEntreprise %}
                    <option value="Produits du terroir et vins"                        {% if (v.filiereCandidat ?? '') == 'Produits du terroir et vins' %}selected{% endif %}>Produits du terroir &amp; vins</option>
                    <option value="Coeur de ville commerçant connecté"                 {% if (v.filiereCandidat ?? '') == 'Coeur de ville commerçant connecté' %}selected{% endif %}>Cœur de ville commerçant connecté</option>
                    <option value="Mobilité douce vélo et accès aux services"          {% if (v.filiereCandidat ?? '') == 'Mobilité douce vélo et accès aux services' %}selected{% endif %}>Mobilité douce, vélo et accès aux services</option>
                    <option value="Clubs et associations sportives"                    {% if (v.filiereCandidat ?? '') == 'Clubs et associations sportives' %}selected{% endif %}>Clubs et associations sportives</option>
                    <option value="Plateforme RH territorial travailleurs saisonniers" {% if (v.filiereCandidat ?? '') == 'Plateforme RH territorial travailleurs saisonniers' %}selected{% endif %}>Plateforme RH territorial / travailleurs saisonniers</option>
                    {% else %}
                    <option value="Produits du terroir et vins"                        {% if (v.filiereCandidat ?? '') == 'Produits du terroir et vins' %}selected{% endif %}>Produits du terroir &amp; vins</option>
                    <option value="Plateforme travailleurs saisonniers"                {% if (v.filiereCandidat ?? '') == 'Plateforme travailleurs saisonniers' %}selected{% endif %}>Plateforme travailleurs saisonniers</option>
                    <option value="Mobilité douce vélo et accès aux services"          {% if (v.filiereCandidat ?? '') == 'Mobilité douce vélo et accès aux services' %}selected{% endif %}>Mobilité douce, vélo et accès aux services</option>
                    <option value="Clubs et associations sportives"                    {% if (v.filiereCandidat ?? '') == 'Clubs et associations sportives' %}selected{% endif %}>Clubs et associations sportives</option>
                    <option value="Commerces augmentés"                                {% if (v.filiereCandidat ?? '') == 'Commerces augmentés' %}selected{% endif %}>Commerces augmentés</option>
                    {% endif %}
                </select>
            </div>
        </div>
        <div class="form-group">
            <label for="besoinTraite">Besoin, irritant ou opportunité traité <span class="required">*</span></label>
            <p class="form-hint">Décrivez le problème concret du territoire, des entreprises, des filières, des habitants ou des visiteurs auquel votre solution répond.</p>
            <textarea id="besoinTraite" name="besoinTraite" rows="4" required placeholder="Quel problème concret adressez-vous ?">{{ v.besoinTraite ?? '' }}</textarea>
        </div>
    </div>

    {% if not isEntreprise %}

    <div class="form-card">
        <h2>3. Résumé du projet</h2>
        <div class="form-group">
            <label for="pitchCourt">Pitch court du projet <span class="required">*</span></label>
            <p class="form-hint">En quelques lignes : le problème traité, la solution proposée, les clients visés et l'impact attendu.</p>
            <textarea id="pitchCourt" name="pitchCourt" rows="3" required placeholder="Décrivez votre projet en 3-4 phrases.">{{ v.pitchCourt ?? '' }}</textarea>
        </div>
        <div class="form-group">
            <label for="problemeIdentifie">Problème ou besoin identifié <span class="required">*</span></label>
            <p class="form-hint">Quel problème concret traitez-vous ? Pour qui ? Sur quelle base l'avez-vous identifié ?</p>
            <textarea id="problemeIdentifie" name="problemeIdentifie" rows="3" required placeholder="Décrivez le problème et sa réalité terrain.">{{ v.problemeIdentifie ?? '' }}</textarea>
        </div>
        <div class="form-group">
            <label for="descriptionProjet">Solution proposée <span class="required">*</span></label>
            <p class="form-hint">Décrivez le produit, service, application, plateforme, équipement ou méthode proposée.</p>
            <textarea id="descriptionProjet" name="descriptionProjet" rows="4" required placeholder="Décrivez votre solution en détail.">{{ v.descriptionProjet ?? '' }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>4. Caractère innovant et différenciation</h2>
        <div class="form-group">
            <label for="innovationDifferentiation">Innovation ou différenciation <span class="required">*</span></label>
            <p class="form-hint">Ce qui est nouveau, différenciant ou plus performant : usage, technologie, modèle, distribution, service, impact.</p>
            <textarea id="innovationDifferentiation" name="innovationDifferentiation" rows="3" required placeholder="En quoi votre solution est-elle innovante ?">{{ v.innovationDifferentiation ?? '' }}</textarea>
        </div>
        <div class="form-group">
            <label for="concurrence">Concurrence et alternatives existantes <span class="required">*</span></label>
            <p class="form-hint">Quelles solutions les clients utilisent-ils aujourd'hui ? Pourquoi votre approche peut-elle être meilleure ou complémentaire ?</p>
            <textarea id="concurrence" name="concurrence" rows="3" required placeholder="Décrivez les alternatives et votre positionnement.">{{ v.concurrence ?? '' }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>5. Marché, clients et usages</h2>
        <div class="form-group">
            <label for="clientsCibles">Clients ou utilisateurs cibles <span class="required">*</span></label>
            <p class="form-hint">Segments prioritaires : particuliers, entreprises, collectivités, touristes, professionnels, filières concernées.</p>
            <textarea id="clientsCibles" name="clientsCibles" rows="3" required placeholder="Qui sont vos utilisateurs cibles ?">{{ v.clientsCibles ?? '' }}</textarea>
        </div>
        <div class="form-group">
            <label for="preuvesBesoin">Preuves de besoin déjà obtenues <span class="required">*</span></label>
            <p class="form-hint">Entretiens, questionnaires, lettres d'intérêt, tests, précommandes, premiers clients, retours terrain.</p>
            <textarea id="preuvesBesoin" name="preuvesBesoin" rows="3" required placeholder="Quelles preuves avez-vous du besoin marché ?">{{ v.preuvesBesoin ?? '' }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>6. Maturité de la solution</h2>
        <div class="form-group">
            <label for="maturite">Niveau de maturité actuel <span class="required">*</span></label>
            <select id="maturite" name="maturite" required>
                <option value="">— Sélectionnez —</option>
                <option value="idée"                    {% if (v.maturite ?? '') == 'idée' %}selected{% endif %}>Idée cadrée</option>
                <option value="maquette"                {% if (v.maturite ?? '') == 'maquette' %}selected{% endif %}>Maquette / prototype</option>
                <option value="MVP"                     {% if (v.maturite ?? '') == 'MVP' %}selected{% endif %}>MVP ou version testable</option>
                <option value="premières ventes"        {% if (v.maturite ?? '') == 'premières ventes' %}selected{% endif %}>Premières ventes</option>
                <option value="recherche de financement"{% if (v.maturite ?? '') == 'recherche de financement' %}selected{% endif %}>Recherche de financement</option>
                <option value="solution vendue"         {% if (v.maturite ?? '') == 'solution vendue' %}selected{% endif %}>Solution déjà utilisée par des clients</option>
                <option value="démonstrateur"           {% if (v.maturite ?? '') == 'démonstrateur' %}selected{% endif %}>Déploiement commercial en cours</option>
                <option value="autre"                   {% if (v.maturite ?? '') == 'autre' %}selected{% endif %}>Autre</option>
            </select>
        </div>
        <div class="form-group" style="margin-top:1rem;">
            <label for="etatAvancement">État d'avancement technique ou opérationnel <span class="required">*</span></label>
            <p class="form-hint">Ce qui existe déjà, ce qui reste à développer, principaux jalons à 3, 6 et 12 mois.</p>
            <textarea id="etatAvancement" name="etatAvancement" rows="3" required placeholder="Décrivez l'avancement et les prochaines étapes.">{{ v.etatAvancement ?? '' }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>7. Modèle économique et financement</h2>
        <div class="form-group">
            <label for="modelEconomique">Modèle économique envisagé <span class="required">*</span></label>
            <p class="form-hint">Vente directe, abonnement, commission, licence, prestation, freemium, achat-revente, autre.</p>
            <textarea id="modelEconomique" name="modelEconomique" rows="3" required placeholder="Comment votre solution génère-t-elle de la valeur économique ?">{{ v.modelEconomique ?? '' }}</textarea>
        </div>
        <div class="form-group">
            <label for="besoinsFinanciers">Besoins financiers et ressources disponibles <span class="required">*</span></label>
            <p class="form-hint">Budget déjà mobilisé, besoins à venir, aides sollicitées, levées de fonds prévues, autofinancement.</p>
            <textarea id="besoinsFinanciers" name="besoinsFinanciers" rows="3" required placeholder="Quels sont vos besoins financiers ?">{{ v.besoinsFinanciers ?? '' }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>8. Équipe et capacité d'exécution</h2>
        <div class="form-group">
            <label for="equipe">Composition de l'équipe <span class="required">*</span></label>
            <p class="form-hint">Nom / prénom — Rôle dans le projet — Compétences / disponibilité</p>
            <textarea id="equipe" name="equipe" rows="4" required placeholder="Ex : Jean Dupont — Développeur — disponible 5j/sem">{{ v.equipe ?? '' }}</textarea>
        </div>
        <div class="form-group">
            <label for="forcesEquipe">Forces de l'équipe et besoins de renfort <span class="required">*</span></label>
            <p class="form-hint">Compétences clés, disponibilité, manques identifiés, recrutements ou partenaires nécessaires.</p>
            <textarea id="forcesEquipe" name="forcesEquipe" rows="3" required placeholder="Quelles sont vos forces et vos besoins de renfort ?">{{ v.forcesEquipe ?? '' }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>9. Besoins d'accompagnement Gigamed Innovation</h2>
        <div class="form-row">
            <div class="form-group">
                <label for="programmeGigamed">Programme souhaité <span class="required">*</span></label>
                <select id="programmeGigamed" name="programmeGigamed" required>
                    <option value="">— Sélectionnez —</option>
                    <option value="incubation"   {% if (v.programmeGigamed ?? '') == 'incubation' %}selected{% endif %}>Incubation — structurer le projet et valider le besoin</option>
                    <option value="amorçage"     {% if (v.programmeGigamed ?? '') == 'amorçage' %}selected{% endif %}>Amorçage — tester le marché et générer les premiers signaux commerciaux</option>
                    <option value="accélération" {% if (v.programmeGigamed ?? '') == 'accélération' %}selected{% endif %}>Accélération — structurer la croissance et le développement</option>
                    <option value="à déterminer" {% if (v.programmeGigamed ?? '') == 'à déterminer' %}selected{% endif %}>À déterminer — je souhaite être orienté par le comité d'instruction</option>
                </select>
            </div>
            <div class="form-group">
                <label for="niveauAccompagnement">Niveau d'accompagnement <span class="required">*</span></label>
                <select id="niveauAccompagnement" name="niveauAccompagnement" required>
                    <option value="">— Sélectionnez —</option>
                    <option value="essentiel"    {% if (v.niveauAccompagnement ?? '') == 'essentiel' %}selected{% endif %}>Essentiel</option>
                    <option value="renforcé"     {% if (v.niveauAccompagnement ?? '') == 'renforcé' %}selected{% endif %}>Renforcé</option>
                    <option value="à déterminer" {% if (v.niveauAccompagnement ?? '') == 'à déterminer' %}selected{% endif %}>À déterminer après instruction</option>
                </select>
            </div>
        </div>
        <div class="form-group" style="margin-top:1rem;">
            <label>Besoins prioritaires <span class="required">*</span></label>
            <p class="form-hint">Cochez tous les besoins qui s'appliquent à votre situation.</p>
            <div class="checkbox-grid">
                {% set besoinsOptions = ['Clarification de la proposition de valeur','Validation du besoin marché','Go-to-market et acquisition client','Structuration commerciale','Business model et stratégie','Préparation financement / pitch deck','Tests utilisateurs / clients',"Accès à des terrains d'expérimentation",'Mise en relation partenaires / mentors','Hébergement / espace de travail','Autre'] %}
                {% for option in besoinsOptions %}
                <label class="checkbox-label">
                    <input type="checkbox" name="besoinsPrioritaires[]" value="{{ option }}" {% if v.besoinsPrioritaires is defined and option in (v.besoinsPrioritaires ?? []) %}checked{% endif %}>
                    <span>{{ option }}</span>
                </label>
                {% endfor %}
            </div>
        </div>
        <div class="form-group">
            <label for="objectifAccompagnement">Objectifs attendus de l'accompagnement <span class="required">*</span></label>
            <p class="form-hint">Quels résultats concrets souhaitez-vous obtenir à l'issue de l'accompagnement ?</p>
            <textarea id="objectifAccompagnement" name="objectifAccompagnement" rows="3" required placeholder="Décrivez vos objectifs.">{{ v.objectifAccompagnement ?? '' }}</textarea>
        </div>
    </div>

    {% else %}
    <div class="form-card">
        <h2>3. Solution proposée</h2>
        <div class="form-group">
            <label for="descriptionProjet">Description synthétique de la solution <span class="required">*</span></label>
            <p class="form-hint">Produit, service, plateforme, équipement, méthode, outil numérique, organisation ou dispositif proposé.</p>
            <textarea id="descriptionProjet" name="descriptionProjet" rows="4" required placeholder="Décrivez votre solution.">{{ v.descriptionProjet ?? '' }}</textarea>
        </div>
        <div class="form-group">
            <label for="valeurAjoutee">Valeur ajoutée pour les utilisateurs ou professionnels <span class="required">*</span></label>
            <p class="form-hint">Bénéfices concrets : gain de temps, ventes, simplicité, sécurité, qualité de service, impact local.</p>
            <textarea id="valeurAjoutee" name="valeurAjoutee" rows="3" required placeholder="Quelle valeur ajoutée concrète apportez-vous ?">{{ v.valeurAjoutee ?? '' }}</textarea>
        </div>
        <div class="form-group">
            <label for="innovationDifferentiation">Innovation ou différenciation <span class="required">*</span></label>
            <p class="form-hint">Précisez ce qui différencie la solution des pratiques existantes.</p>
            <textarea id="innovationDifferentiation" name="innovationDifferentiation" rows="3" required placeholder="En quoi votre solution se différencie-t-elle ?">{{ v.innovationDifferentiation ?? '' }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>4. Références, maturité et capacité de déploiement</h2>
        <div class="form-group">
            <label for="maturite">Maturité actuelle <span class="required">*</span></label>
            <select id="maturite" name="maturite" required>
                <option value="">— Sélectionnez —</option>
                <option value="idée"                    {% if (v.maturite ?? '') == 'idée' %}selected{% endif %}>Idée</option>
                <option value="maquette"                {% if (v.maturite ?? '') == 'maquette' %}selected{% endif %}>Maquette / prototype</option>
                <option value="MVP"                     {% if (v.maturite ?? '') == 'MVP' %}selected{% endif %}>MVP ou version testable</option>
                <option value="premières ventes"        {% if (v.maturite ?? '') == 'premières ventes' %}selected{% endif %}>Premières ventes</option>
                <option value="recherche de financement"{% if (v.maturite ?? '') == 'recherche de financement' %}selected{% endif %}>Recherche de financement</option>
                <option value="solution vendue"         {% if (v.maturite ?? '') == 'solution vendue' %}selected{% endif %}>Solution déjà vendue ou utilisée</option>
                <option value="démonstrateur"           {% if (v.maturite ?? '') == 'démonstrateur' %}selected{% endif %}>Démonstrateur existant</option>
                <option value="autre"                   {% if (v.maturite ?? '') == 'autre' %}selected{% endif %}>Autre</option>
            </select>
        </div>
        <div class="form-group" style="margin-top:1rem;">
            <label for="references">Références clients, pilotes ou réalisations existantes <span class="required">*</span></label>
            <p class="form-hint">Réalisations comparables, chiffres d'usage, retours clients ou démonstrations disponibles.</p>
            <textarea id="references" name="references" rows="3" required placeholder="Pilotes existants, clients actuels, retours terrain…">{{ v.references ?? '' }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>5. Proposition d'expérimentation Station T</h2>
        <div class="form-group">
            <label for="objectifPilote">Objectif du pilote proposé <span class="required">*</span></label>
            <p class="form-hint">Quel test souhaitez-vous mener sur le territoire ? Quel résultat permettrait de conclure à un Go / No Go ?</p>
            <textarea id="objectifPilote" name="objectifPilote" rows="3" required placeholder="Décrivez l'objectif du pilote.">{{ v.objectifPilote ?? '' }}</textarea>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="perimetreGeographique">Périmètre géographique <span class="required">*</span></label>
