{% extends 'base/base.html.twig' %}
{% set isAdmin = isAdmin ?? false %}
{% set isModification = isAdmin and candidature is defined and candidature is not null %}

{% block titre %}{% if isModification %}Modifier la candidature — Administration{% elseif isAdmin %}Soumettre une candidature — Administration{% else %}Candidature — Station T{% endif %}{% endblock %}

{% block contenu %}

{% set c = isModification ? candidature : null %}
{% set v = ancien ?? {} %}
{% set isEntreprise = false %}
{% set action = '' %}

{% macro docActuel(doc, inputId, required) %}
    {% if doc is not null %}
    <div id="doc-current-{{ inputId }}" style="display:flex; align-items:center; gap:.75rem; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:6px; padding:.4rem .75rem; margin-bottom:.4rem;">
        <span style="color:#047857; font-size:.88rem;">✓ Fichier joint</span>
        <button type="button" data-input="{{ inputId }}" data-required="{{ required ? '1' : '0' }}"
                onclick="supprimerDoc({{ doc.idDocument }}, '{{ route('supprimerDocument', {idDoc: doc.idDocument}) }}', this)"
                class="abtn abtn-red" style="padding:.2rem .55rem; font-size:.78rem; margin-left:auto;">Supprimer</button>
    </div>
    {% endif %}
{% endmacro %}

{% if not isAdmin %}
    {% if brouillon is not null and ancien is not defined %}
    {% set v = {
        'nomProjet': brouillon.nomProjet,
        'entreeStationT': brouillon.entreeStationT.value,
        'filiereCandidat': brouillon.filiereCandidat,
        'besoinTraite': brouillon.besoinTraite,
        'descriptionProjet': brouillon.descriptionProjet,
        'valeurAjoutee': brouillon.valeurAjoutee,
        'innovationDifferentiation': brouillon.innovationDifferentiation,
        'maturite': brouillon.maturite.value,
        'references': brouillon.references,
        'objectifPilote': brouillon.objectifPilote,
        'perimetreGeographique': brouillon.perimetreGeographique,
        'dureeExperimentation': brouillon.dureeExperimentation,
        'publicsCibles': brouillon.publicsCibles,
        'budgetMobiliser': brouillon.budgetMobiliser,
        'moyensMobiliser': brouillon.moyensMobiliser,
        'conditionsReussite': brouillon.conditionsReussite,
        'derouteOperationnel': brouillon.derouteOperationnel,
        'partenairesRecherches': brouillon.partenairesRecherches,
        'modelEconomique': brouillon.modelEconomique,
        'conditionsDeploiement': brouillon.conditionsDeploiement,
        'impactAttendu': brouillon.impactAttendu,
        'pitchCourt': brouillon.pitchCourt,
        'problemeIdentifie': brouillon.problemeIdentifie,
        'concurrence': brouillon.concurrence,
        'clientsCibles': brouillon.clientsCibles,
        'preuvesBesoin': brouillon.preuvesBesoin,
        'etatAvancement': brouillon.etatAvancement,
        'besoinsFinanciers': brouillon.besoinsFinanciers,
        'equipe': brouillon.equipe,
        'forcesEquipe': brouillon.forcesEquipe,
        'programmeGigamed': brouillon.programmeGigamed is not null ? brouillon.programmeGigamed.value : '',
        'niveauAccompagnement': brouillon.niveauAccompagnement is not null ? brouillon.niveauAccompagnement.value : '',
        'objectifAccompagnement': brouillon.objectifAccompagnement,
        'besoinsPrioritaires': brouillonBesoinsPrioritaires,
        'appuisStationT': brouillonAppuisStationT,
    } %}
    {% endif %}
    {% set action = ami is not null ? route('deposerCandidatureAmi', {idAmi: ami.idAmi}) : route('deposerCandidatureChallenge', {idChallenge: challenge.idChallenge}) %}
    {% set isEntreprise = utilisateur.roleUtilisateur.value == 'entreprise' %}
{% endif %}

{% if isAdmin %}
<div class="admin-hero">
    <div class="admin-hero-left">
        <span class="admin-hero-tag">Administration — {% if isModification %}Modification{% else %}Saisie papier{% endif %}</span>
        <h1>{% if isModification %}Modifier la candidature{% else %}Soumettre une candidature au nom d'un utilisateur{% endif %}</h1>
        <p>{% if isModification %}{{ c.nomProjet }}{% else %}Le formulaire s'adapte automatiquement au rôle de l'utilisateur sélectionné.{% endif %}</p>
    </div>
    <div class="admin-hero-right">
        {% if isModification %}
        <a href="{{ route('adminDetailCandidature', {id: c.idCandidature}) }}" class="btn btn-outline-white">← Retour à la candidature</a>
        {% else %}
        <a href="{{ route('adminCandidatures') }}" class="btn btn-outline-white">← Retour aux candidatures</a>
        {% endif %}
    </div>
</div>
<div class="admin-nav-strip">
    <a href="{{ route('adminDashboard') }}">Tableau de bord</a>
    <span class="admin-nav-sep"></span>
    <a href="{{ route('adminUtilisateurs') }}">Utilisateurs</a>
    <a href="{{ route('adminBesoins') }}">Besoins</a>
    <a href="{{ route('adminCandidatures') }}" class="admin-nav-active">Candidatures</a>
    <a href="{{ route('adminAmi') }}">AMI</a>
    <a href="{{ route('adminChallenges') }}">Challenges</a>
    <span class="admin-nav-sep"></span>
    {% if utilisateur.roleUtilisateur.value == 'superAdmin' %}<a href="{{ route('adminAffectations') }}">Affectations</a>{% endif %}
    <a href="{{ route('adminJournal') }}">Journal</a>
</div>
{% else %}
<section class="hero">
    <div class="hero-tag">Candidature</div>
    <h1>Déposer une candidature</h1>
    <p>
        {% if ami is not null %}AMI : <strong>{{ ami.titreAmi }}</strong>
        {% else %}Challenge : <strong>{{ challenge.titreChallenge }}</strong>{% endif %}
    </p>
    <div class="hero-actions">
        <a href="{{ ami is not null ? route('listeAmi') : route('listeChallenges') }}" class="btn btn-outline-white">← Retour</a>
    </div>
</section>
{% if brouillon is not null and ancien is not defined %}
<div class="page-form-wide" style="padding-top:0; padding-bottom:0;">
    <div style="background:#fef3c7; border:1px solid #f59e0b; border-radius:8px; padding:.85rem 1.25rem; color:#92400e; font-size:.9rem;">
        Vous avez un brouillon enregistré. Les champs ci-dessous ont été préremplis. Complétez et déposez votre candidature.
    </div>
</div>
{% endif %}
{% endif %}

<div class="page-form-wide">
<form method="POST"
      action="{% if isModification %}{{ route('adminModifierCandidature', {id: c.idCandidature}) }}{% elseif isAdmin %}{{ route('adminSoumettreCandidature') }}{% else %}{{ action }}{% endif %}"
      enctype="multipart/form-data">

{% if isModification %}

    {% set docs = docsExistants ?? {} %}
    {% set isEntrepriseC = isEntrepriseCandidat ?? false %}

    <div class="form-card">
        <h2>Statut</h2>
        <div class="form-group">
            <label for="statutCandidature">Statut <span class="required">*</span></label>
            <select id="statutCandidature" name="statutCandidature" required>
                {% for s in statuts %}
                <option value="{{ s.value }}" {% if (v.statutCandidature ?? statutCandidatureValue ?? '') == s.value %}selected{% endif %}>{{ s.value|capitalize }}</option>
                {% endfor %}
            </select>
        </div>
    </div>

    {% set currentEntree = v.entreeStationT ?? entreeStationTValue ?? '' %}
    {% set currentFiliere = v.filiereCandidat ?? c.filiereCandidat ?? '' %}

    <div class="form-card">
        <h2>1. Identification du projet</h2>
        <div class="form-group">
            <label for="nomProjet">Nom du projet <span class="required">*</span></label>
            <input type="text" id="nomProjet" name="nomProjet" value="{{ v.nomProjet ?? c.nomProjet }}" required>
        </div>

        <div class="form-group">
            <label>Entrée dans Station T <span class="required">*</span></label>
            <div class="form-radio-group">
                <label class="radio-label">
                    <input type="radio" name="entreeStationT" value="option1" {% if currentEntree == 'option1' %}checked{% endif %} required onchange="majFiliereMod(this.value)">
                    <span><strong>Option 01</strong> — Réponse à un besoin filière identifié</span>
                </label>
                <label class="radio-label">
                    <input type="radio" name="entreeStationT" value="option2" {% if currentEntree == 'option2' %}checked{% endif %} onchange="majFiliereMod(this.value)">
                    <span><strong>Option 02</strong> — Réponse à un cas d'usage interfilières Station T</span>
                </label>
                <label class="radio-label">
                    <input type="radio" name="entreeStationT" value="option3" {% if currentEntree == 'option3' %}checked{% endif %} onchange="majFiliereMod(this.value)">
                    <span><strong>Option 03</strong> — Besoin complémentaire proposé par le candidat avec pertinence territoriale démontrée</span>
                </label>
            </div>
        </div>
        <input type="hidden" name="filiereCandidat" id="filiereCandidat-mod-hidden" value="{{ currentFiliere }}">
        <div id="mod-bloc-filiere-option1" style="display:none;">
            <div class="form-group">
                <label for="mod-filiere-select-opt1">Filière concernée <span class="required">*</span></label>
                <select id="mod-filiere-select-opt1">
                    <option value="">— Sélectionnez une filière —</option>
                    <option value="tourisme"    {% if currentFiliere == 'tourisme' %}selected{% endif %}>Tourisme balnéaire &amp; durable</option>
                    <option value="nautisme"    {% if currentFiliere == 'nautisme' %}selected{% endif %}>Nautisme, plaisance &amp; fluvial</option>
                    <option value="sport"       {% if currentFiliere == 'sport' %}selected{% endif %}>Sport, bien-être &amp; loisirs</option>
                    <option value="agriculture" {% if currentFiliere == 'agriculture' %}selected{% endif %}>Agriculture &amp; viticulture</option>
                    <option value="commerce"    {% if currentFiliere == 'commerce' %}selected{% endif %}>Commerce &amp; artisanat</option>
                    <option value="ville"       {% if currentFiliere == 'ville' %}selected{% endif %}>Ville de demain &amp; services de proximité</option>
                </select>
            </div>
        </div>
        <div id="mod-bloc-filiere-option2" style="display:none;">
            <div class="form-group">
                <label for="mod-filiere-select-opt2">Cas d'usage interfilières <span class="required">*</span></label>
                <select id="mod-filiere-select-opt2">
                    <option value="">— Sélectionnez un cas d'usage —</option>
                    <option value="Produits du terroir et vins"                        {% if currentFiliere == 'Produits du terroir et vins' %}selected{% endif %}>Produits du terroir &amp; vins</option>
                    <option value="Coeur de ville commerçant connecté"                 {% if currentFiliere == 'Coeur de ville commerçant connecté' %}selected{% endif %}>Cœur de ville commerçant connecté</option>
                    <option value="Mobilité douce vélo et accès aux services"          {% if currentFiliere == 'Mobilité douce vélo et accès aux services' %}selected{% endif %}>Mobilité douce, vélo et accès aux services</option>
                    <option value="Clubs et associations sportives"                    {% if currentFiliere == 'Clubs et associations sportives' %}selected{% endif %}>Clubs et associations sportives</option>
                    <option value="Plateforme RH territorial travailleurs saisonniers" {% if currentFiliere == 'Plateforme RH territorial travailleurs saisonniers' %}selected{% endif %}>Plateforme RH territorial / travailleurs saisonniers</option>
                    <option value="Plateforme travailleurs saisonniers"                {% if currentFiliere == 'Plateforme travailleurs saisonniers' %}selected{% endif %}>Plateforme travailleurs saisonniers</option>
                    <option value="Commerces augmentés"                                {% if currentFiliere == 'Commerces augmentés' %}selected{% endif %}>Commerces augmentés</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label for="besoinTraite">Besoin traité <span class="required">*</span></label>
            <textarea id="besoinTraite" name="besoinTraite" rows="2" required>{{ v.besoinTraite ?? c.besoinTraite }}</textarea>
        </div>
    </div>

    {% if not isEntrepriseC %}

    
    <div class="form-card">
        <h2>2. Résumé du projet</h2>
        <div class="form-group">
            <label for="pitchCourt">Pitch court du projet</label>
            <textarea id="pitchCourt" name="pitchCourt" rows="3">{{ v.pitchCourt ?? c.pitchCourt }}</textarea>
        </div>
        <div class="form-group">
            <label for="problemeIdentifie">Problème ou besoin identifié</label>
            <textarea id="problemeIdentifie" name="problemeIdentifie" rows="3">{{ v.problemeIdentifie ?? c.problemeIdentifie }}</textarea>
        </div>
        <div class="form-group">
            <label for="descriptionProjet">Solution proposée <span class="required">*</span></label>
            <textarea id="descriptionProjet" name="descriptionProjet" rows="4" required>{{ v.descriptionProjet ?? c.descriptionProjet }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>3. Innovation &amp; différenciation</h2>
        <div class="form-group">
            <label for="innovationDifferentiation">Innovation ou différenciation <span class="required">*</span></label>
            <textarea id="innovationDifferentiation" name="innovationDifferentiation" rows="3" required>{{ v.innovationDifferentiation ?? c.innovationDifferentiation }}</textarea>
        </div>
        <div class="form-group">
            <label for="concurrence">Concurrence et alternatives existantes</label>
            <textarea id="concurrence" name="concurrence" rows="3">{{ v.concurrence ?? c.concurrence }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>4. Marché, clients et usages</h2>
        <div class="form-group">
            <label for="clientsCibles">Clients ou utilisateurs cibles</label>
            <textarea id="clientsCibles" name="clientsCibles" rows="3">{{ v.clientsCibles ?? c.clientsCibles }}</textarea>
        </div>
        <div class="form-group">
            <label for="preuvesBesoin">Preuves de besoin déjà obtenues</label>
            <textarea id="preuvesBesoin" name="preuvesBesoin" rows="3">{{ v.preuvesBesoin ?? c.preuvesBesoin }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>5. Maturité de la solution</h2>
        <div class="form-group">
            <label for="maturite">Stade de maturité <span class="required">*</span></label>
            <select id="maturite" name="maturite" required>
                <option value="idée"                    {% if (v.maturite ?? maturiteValue ?? '') == 'idée' %}selected{% endif %}>Idée</option>
                <option value="maquette"                {% if (v.maturite ?? maturiteValue ?? '') == 'maquette' %}selected{% endif %}>Maquette</option>
                <option value="MVP"                     {% if (v.maturite ?? maturiteValue ?? '') == 'MVP' %}selected{% endif %}>MVP</option>
                <option value="premières ventes"        {% if (v.maturite ?? maturiteValue ?? '') == 'premières ventes' %}selected{% endif %}>Premières ventes</option>
                <option value="recherche de financement"{% if (v.maturite ?? maturiteValue ?? '') == 'recherche de financement' %}selected{% endif %}>Recherche de financement</option>
                <option value="solution vendue"         {% if (v.maturite ?? maturiteValue ?? '') == 'solution vendue' %}selected{% endif %}>Solution vendue</option>
                <option value="démonstrateur"           {% if (v.maturite ?? maturiteValue ?? '') == 'démonstrateur' %}selected{% endif %}>Démonstrateur</option>
                <option value="autre"                   {% if (v.maturite ?? maturiteValue ?? '') == 'autre' %}selected{% endif %}>Autre</option>
            </select>
        </div>
        <div class="form-group">
            <label for="etatAvancement">État d'avancement</label>
            <textarea id="etatAvancement" name="etatAvancement" rows="3">{{ v.etatAvancement ?? c.etatAvancement }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>6. Modèle économique et financement</h2>
        <div class="form-group">
            <label for="modelEconomique">Modèle économique <span class="required">*</span></label>
            <textarea id="modelEconomique" name="modelEconomique" rows="3" required>{{ v.modelEconomique ?? c.modelEconomique }}</textarea>
        </div>
        <div class="form-group">
            <label for="besoinsFinanciers">Besoins financiers</label>
            <textarea id="besoinsFinanciers" name="besoinsFinanciers" rows="3">{{ v.besoinsFinanciers ?? c.besoinsFinanciers }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>7. Équipe et capacité d'exécution</h2>
        <div class="form-group">
            <label for="equipe">Composition de l'équipe</label>
            <textarea id="equipe" name="equipe" rows="4">{{ v.equipe ?? c.equipe }}</textarea>
        </div>
        <div class="form-group">
            <label for="forcesEquipe">Forces de l'équipe</label>
            <textarea id="forcesEquipe" name="forcesEquipe" rows="3">{{ v.forcesEquipe ?? c.forcesEquipe }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>8. Accompagnement Gigamed Innovation</h2>
        <div class="form-row">
            <div class="form-group">
                <label for="programmeGigamed">Programme souhaité</label>
                <select id="programmeGigamed" name="programmeGigamed">
                    <option value="">— Aucun —</option>
                    <option value="incubation"   {% if (v.programmeGigamed ?? c.programmeGigamed?.value) == 'incubation' %}selected{% endif %}>Incubation</option>
                    <option value="amorçage"     {% if (v.programmeGigamed ?? c.programmeGigamed?.value) == 'amorçage' %}selected{% endif %}>Amorçage</option>
                    <option value="accélération" {% if (v.programmeGigamed ?? c.programmeGigamed?.value) == 'accélération' %}selected{% endif %}>Accélération</option>
                    <option value="à déterminer" {% if (v.programmeGigamed ?? c.programmeGigamed?.value) == 'à déterminer' %}selected{% endif %}>À déterminer</option>
                </select>
            </div>
            <div class="form-group">
                <label for="niveauAccompagnement">Niveau d'accompagnement</label>
                <select id="niveauAccompagnement" name="niveauAccompagnement">
                    <option value="">— Aucun —</option>
                    <option value="essentiel"    {% if (v.niveauAccompagnement ?? c.niveauAccompagnement?.value) == 'essentiel' %}selected{% endif %}>Essentiel</option>
                    <option value="renforcé"     {% if (v.niveauAccompagnement ?? c.niveauAccompagnement?.value) == 'renforcé' %}selected{% endif %}>Renforcé</option>
                    <option value="à déterminer" {% if (v.niveauAccompagnement ?? c.niveauAccompagnement?.value) == 'à déterminer' %}selected{% endif %}>À déterminer</option>
                </select>
            </div>
        </div>
        <div class="form-group">
            <label>Besoins prioritaires</label>
            <div class="checkbox-grid">
                {% set besoinsOptions = ['Clarification de la proposition de valeur','Validation du besoin marché','Go-to-market et acquisition client','Structuration commerciale','Business model et stratégie','Préparation financement / pitch deck','Tests utilisateurs / clients',"Accès à des terrains d'expérimentation",'Mise en relation partenaires / mentors','Hébergement / espace de travail','Autre'] %}
                {% set bpActifs = v.besoinsPrioritaires is defined and v.besoinsPrioritaires is iterable ? v.besoinsPrioritaires : (besoinsPrioritairesDecodes ?? []) %}
                {% for option in besoinsOptions %}
                <label class="checkbox-label">
                    <input type="checkbox" name="besoinsPrioritaires[]" value="{{ option }}" {% if option in bpActifs %}checked{% endif %}>
                    <span>{{ option }}</span>
                </label>
                {% endfor %}
            </div>
        </div>
        <div class="form-group">
            <label for="objectifAccompagnement">Objectif d'accompagnement</label>
            <textarea id="objectifAccompagnement" name="objectifAccompagnement" rows="2">{{ v.objectifAccompagnement ?? c.objectifAccompagnement }}</textarea>
        </div>
    </div>

    {% else %}

    
    <div class="form-card">
        <h2>2. Solution proposée</h2>
        <div class="form-group">
            <label for="descriptionProjet">Description synthétique de la solution <span class="required">*</span></label>
            <textarea id="descriptionProjet" name="descriptionProjet" rows="4" required>{{ v.descriptionProjet ?? c.descriptionProjet }}</textarea>
        </div>
        <div class="form-group">
            <label for="valeurAjoutee">Valeur ajoutée pour les utilisateurs</label>
            <textarea id="valeurAjoutee" name="valeurAjoutee" rows="3">{{ v.valeurAjoutee ?? c.valeurAjoutee }}</textarea>
        </div>
        <div class="form-group">
            <label for="innovationDifferentiation">Innovation ou différenciation <span class="required">*</span></label>
            <textarea id="innovationDifferentiation" name="innovationDifferentiation" rows="3" required>{{ v.innovationDifferentiation ?? c.innovationDifferentiation }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>3. Références, maturité et capacité</h2>
        <div class="form-group">
            <label for="maturite">Stade de maturité <span class="required">*</span></label>
            <select id="maturite" name="maturite" required>
                <option value="idée"                    {% if (v.maturite ?? maturiteValue ?? '') == 'idée' %}selected{% endif %}>Idée</option>
                <option value="maquette"                {% if (v.maturite ?? maturiteValue ?? '') == 'maquette' %}selected{% endif %}>Maquette</option>
                <option value="MVP"                     {% if (v.maturite ?? maturiteValue ?? '') == 'MVP' %}selected{% endif %}>MVP</option>
                <option value="premières ventes"        {% if (v.maturite ?? maturiteValue ?? '') == 'premières ventes' %}selected{% endif %}>Premières ventes</option>
                <option value="recherche de financement"{% if (v.maturite ?? maturiteValue ?? '') == 'recherche de financement' %}selected{% endif %}>Recherche de financement</option>
                <option value="solution vendue"         {% if (v.maturite ?? maturiteValue ?? '') == 'solution vendue' %}selected{% endif %}>Solution vendue</option>
                <option value="démonstrateur"           {% if (v.maturite ?? maturiteValue ?? '') == 'démonstrateur' %}selected{% endif %}>Démonstrateur</option>
                <option value="autre"                   {% if (v.maturite ?? maturiteValue ?? '') == 'autre' %}selected{% endif %}>Autre</option>
            </select>
        </div>
        <div class="form-group">
            <label for="references">Références clients, pilotes ou réalisations</label>
            <textarea id="references" name="references" rows="3">{{ v.references ?? c.references_ }}</textarea>
        </div>
    </div>

    <div class="form-card">
        <h2>4. Expérimentation Station T</h2>
        <div class="form-group">
            <label for="objectifPilote">Objectif du pilote</label>
            <textarea id="objectifPilote" name="objectifPilote" rows="3">{{ v.objectifPilote ?? c.objectifPilote }}</textarea>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="perimetreGeographique">Périmètre géographique</label>
                <input type="text" id="perimetreGeographique" name="perimetreGeographique" value="{{ v.perimetreGeographique ?? c.perimetreGeographique }}">
            </div>
            <div class="form-group">
                <label for="dureeExperimentation">Durée d'expérimentation</label>
                <input type="text" id="dureeExperimentation" name="dureeExperimentation" value="{{ v.dureeExperimentation ?? c.dureeExperimentation }}">
            </div>
        </div>
        <div class="form-group">
            <label for="publicsCibles">Publics cibles</label>
            <textarea id="publicsCibles" name="publicsCibles" rows="2">{{ v.publicsCibles ?? c.publicsCibles }}</textarea>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="budgetMobiliser">Budget à mobiliser</label>
                <input type="text" id="budgetMobiliser" name="budgetMobiliser" value="{{ v.budgetMobiliser ?? c.budgetMobiliser }}">
            </div>
            <div class="form-group">
                <label for="moyensMobiliser">Moyens à mobiliser</label>
                <input type="text" id="moyensMobiliser" name="moyensMobiliser" value="{{ v.moyensMobiliser ?? c.moyensMobiliser }}">
            </div>
        </div>
        <div class="form-group">
            <label for="conditionsReussite">Conditions de réussite</label>
            <textarea id="conditionsReussite" name="conditionsReussite" rows="3">{{ v.conditionsReussite ?? c.conditionsReussite }}</textarea>
        </div>
        <div class="form-group">
            <label for="derouteOperationnel">Déroulé opérationnel</label>
