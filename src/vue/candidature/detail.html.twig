        {% if candidature.dureeExperimentation %}
        <div class="form-group">
            <label>Durée souhaitée</label>
            <p class="info-value">{{ candidature.dureeExperimentation }}</p>
        </div>
        {% endif %}
    </div>
    {% if candidature.publicsCibles %}
    <div class="form-group">
        <label>Publics ou utilisateurs ciblés</label>
        <p class="info-value">{{ candidature.publicsCibles }}</p>
    </div>
    {% endif %}
    <div class="form-row">
        {% if candidature.budgetMobiliser %}
        <div class="form-group">
            <label>Budget à mobiliser</label>
            <p class="info-value">{{ candidature.budgetMobiliser }}</p>
        </div>
        {% endif %}
        {% if candidature.moyensMobiliser %}
        <div class="form-group">
            <label>Moyens à mobiliser</label>
            <p class="info-value">{{ candidature.moyensMobiliser }}</p>
        </div>
        {% endif %}
    </div>
    {% if candidature.conditionsReussite %}
    <div class="form-group">
        <label>Conditions de réussite</label>
        <p class="info-value">{{ candidature.conditionsReussite }}</p>
    </div>
    {% endif %}
    {% if candidature.derouteOperationnel %}
    <div class="form-group">
        <label>Déroulé opérationnel envisagé</label>
        <p class="info-value">{{ candidature.derouteOperationnel }}</p>
    </div>
    {% endif %}
</div>

<div class="form-card">
    <h2>5. Partenaires, sites pilotes et appuis Station T</h2>
    {% if candidature.partenairesRecherches %}
    <div class="form-group">
        <label>Partenaires ou sites pilotes recherchés</label>
        <p class="info-value">{{ candidature.partenairesRecherches }}</p>
    </div>
    {% endif %}
    {% if candidature.appuisStationT %}
    <div class="form-group">
        <label>Appuis attendus de Station T</label>
        <ul style="margin:.5rem 0 0 1.25rem; padding:0;">
            {% for appui in candidature.appuisStationT|split(', ') %}
            <li style="margin-bottom:.3rem;">{{ appui }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}
</div>

<div class="form-card">
    <h2>6. Modèle économique et conditions de déploiement</h2>
    <div class="form-group">
        <label>Modèle économique</label>
        <p class="info-value">{{ candidature.modelEconomique }}</p>
    </div>
    {% if candidature.conditionsDeploiement %}
    <div class="form-group">
        <label>Conditions de déploiement après pilote</label>
        <p class="info-value">{{ candidature.conditionsDeploiement }}</p>
    </div>
    {% endif %}
</div>

<div class="form-card">
    <h2>7. Impacts attendus et indicateurs</h2>
    {% if candidature.impactAttendu %}
    <div class="form-group">
        <label>Impacts attendus</label>
        <p class="info-value">{{ candidature.impactAttendu }}</p>
    </div>
    {% endif %}
</div>

{% endif %}

<div class="form-card">
    <h2>{% if isEntreprise %}8{% else %}9{% endif %}. Engagements</h2>
    <div class="form-group">
        <p class="info-value" style="display:flex; align-items:center; gap:.5rem;">
            {% if candidature.engagements %}
            <span style="color:#16a34a; font-size:1.2rem;">✓</span> Engagements validés
            {% else %}
            <span style="color:#dc2626; font-size:1.2rem;">✗</span> Engagements non validés
            {% endif %}
        </p>
    </div>
</div>

{% if documents is not empty %}
<div class="form-card">
    <h2>{% if isEntreprise %}9{% else %}10{% endif %}. Pièces jointes</h2>
    <div style="display:flex; flex-direction:column; gap:.75rem;">
        {% for doc in documents %}
        <div style="display:flex; align-items:center; justify-content:space-between; padding:.75rem 1rem; background:#f8f9fa; border-radius:8px; border:1px solid #e5e7eb;">
            <div>
                <span style="font-weight:500;">{{ doc.nomDocument }}</span>
                <span style="color:#6b7280; font-size:.85rem; margin-left:.75rem;">{{ doc.typeDocument.value|upper }}</span>
                <span style="color:#9ca3af; font-size:.8rem; margin-left:.75rem;">{{ doc.dateUpload|date('d/m/Y') }}</span>
            </div>
            <div style="display:flex; align-items:center; gap:.75rem;">
                <a href="{{ asset('../ressources/uploads/candidatures/' ~ (doc.cheminDocument|split('/')|last)) }}" target="_blank"
                   style="color:var(--bleu); text-decoration:none; font-size:.9rem; white-space:nowrap;">
                    Télécharger ↗
                </a>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

</div>
{% endblock %}